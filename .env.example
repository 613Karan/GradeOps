# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# PostgreSQL — Railway auto-fills this when you add the PostgreSQL plugin
DATABASE_URL=postgresql+psycopg2://gradeops:gradeops@localhost:5432/gradeops

# Ollama — point to ngrok URL in production, localhost in dev
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5:0.5b
OLLAMA_OCR_MODEL=qwen2.5vl:3b
OLLAMA_GRADING_MODEL=qwen2.5:7b

# File storage — set USE_CLOUDINARY=true in production and fill in credentials
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local dev only
UPLOAD_DIR=./uploads
DEBUG=false
