# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Must match the credentials in docker-compose.yml (do not change unless you
# also update docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://gradeops:gradeops@postgres:5432/gradeops

# ── Groq API ──────────────────────────────────────────────────────────────────
# Free tier — no credit card required.
# Sign up at https://console.groq.com → API Keys → Create API Key
# Used for: cover-page detection, OCR (prose), granular grading
GROQ_API_KEY=gsk_...

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Free tier — no credit card required.
# Sign up at https://aistudio.google.com → Get API Key → Create API key in new project
# Used for: OCR on math-heavy handwritten answers (equations, derivations)
GEMINI_API_KEY=AIza...

# ── File storage ──────────────────────────────────────────────────────────────
# Leave as-is for local development. PDF scans and cropped answer images are
# saved to ./uploads/ on the host machine (mounted into the Docker container).
UPLOAD_DIR=./uploads

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
